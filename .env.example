# MERN Rebuild Environment Variables
# Copy to .env and fill in values

MONGO_URI=mongodb://localhost:27017/supreme-mern
# Or MongoDB Atlas: mongodb+srv://user:pass@cluster.mongodb.net/supreme-mern?retryWrites=true&w=majority

JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
PORT=5001

# Optional
NODE_ENV=development

